    <decisions>
        <name>Contact_Found</name>
        <label>Contact Found?</label>
        <locationX>578</locationX>
        <locationY>242</locationY>
        <defaultConnector>
            <targetReference>Assign_Not_Found</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Contact</defaultConnectorLabel>
        <rules>
            <name>Has_Contact</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Contact</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Enquiry</targetReference>
            </connector>
            <label>Has Contact</label>
        </rules>
    </decisions>
    <decisions>
        <name>Enquiry_Found</name>
        <label>Enquiry Found?</label>
        <locationX>314</locationX>
        <locationY>566</locationY>
        <defaultConnector>
            <targetReference>Assign_Not_Found</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Enquiry</defaultConnectorLabel>
        <rules>
            <name>Has_Enquiry</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Enquiry</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Is_Closed</targetReference>
            </connector>
            <label>Has Enquiry</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_Closed</name>
        <label>Is Closed?</label>
        <locationX>182</locationX>
        <locationY>674</locationY>
        <defaultConnector>
            <targetReference>Assign_Open</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Open</defaultConnectorLabel>
        <rules>
            <name>Closed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Enquiry.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Closed</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Closed</targetReference>
            </connector>
            <label>Closed</label>
        </rules>
    </decisions>
    <description>Agentforce action for the Enquiry Status Check topic. Finds the Contact by email, fetches their latest Enquiry and returns its status with the next step. Only ever returns the enquiry of the contact matching the given email.</description>
    <environments>Default</environments>
    <formulas>
        <name>fMessageClosed</name>
        <dataType>String</dataType>
        <expression>&quot;Your latest enquiry &quot; &amp; {!Get_Enquiry.Name} &amp; &quot; (&quot; &amp; {!Get_Enquiry.Subject__c} &amp; &quot;) is Closed&quot; &amp; IF(ISBLANK({!Get_Enquiry.Closed_Date__c}), &quot;&quot;, &quot; - it was closed on &quot; &amp; TEXT({!Get_Enquiry.Closed_Date__c})) &amp; &quot;. Would you like to raise a new enquiry?&quot;</expression>
    </formulas>
    <formulas>
        <name>fMessageOpen</name>
        <dataType>String</dataType>
        <expression>&quot;Your latest enquiry &quot; &amp; {!Get_Enquiry.Name} &amp; &quot; (&quot; &amp; {!Get_Enquiry.Subject__c} &amp; &quot;) is currently &quot; &amp; TEXT({!Get_Enquiry.Status__c}) &amp; &quot;. Our team is working on it and will follow up with you shortly.&quot;</expression>
    </formulas>
    <formulas>
        <name>fStatusText</name>
        <dataType>String</dataType>
        <expression>TEXT({!Get_Enquiry.Status__c})</expression>
    </formulas>
    <interviewLabel>Get Enquiry Status By Email {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Get Enquiry Status By Email</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Contact</name>
        <label>Get Contact</label>
        <locationX>578</locationX>
        <locationY>134</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Contact_Found</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Email</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>customerEmail</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Contact</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Enquiry</name>
        <label>Get Latest Enquiry</label>
        <locationX>314</locationX>
        <locationY>350</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Enquiry_Found</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Contact__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Contact.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Enquiry__c</object>
        <sortField>CreatedDate</sortField>
        <sortOrder>Desc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <runInMode>SystemModeWithoutSharing</runInMode>
    <start>
        <locationX>452</locationX>
        <locationY>0</locationY>
